local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Window = Rayfield:CreateWindow({
    Name = "Lucky Block",
    LoadingTitle = "Lucky Block",
    LoadingSubtitle = "by ChatGPT",
})

local Tab = Window:CreateTab("Main", 4483362458)

local Running = false
local Delay = 0.1 -- ค่าเริ่มต้น

Tab:CreateSlider({
    Name = "Speed",
    Range = {0.05, 2},
    Increment = 0.05,
    Suffix = "s",
    CurrentValue = 0.1,
    Flag = "Speed",
    Callback = function(Value)
        Delay = Value
    end,
})

Tab:CreateToggle({
    Name = "Auto Spawn Lucky Block",
    CurrentValue = false,
    Flag = "AutoLucky",
    Callback = function(Value)
        Running = Value

        if Running then
            task.spawn(function()
                while Running do
                    pcall(function()
                        game:GetService("ReplicatedStorage"):WaitForChild("SpawnLuckyBlock"):FireServer()
                    end)
                    task.wait(Delay)
                end
            end)
        end
    end,
})
